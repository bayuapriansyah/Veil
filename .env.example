# ============================================================================ #
#  VEIL - Phase 2 environment configuration (CC3 Testnet + Sepolia)
#  See docs/attestcoin.md for the verified source of these values.
# ============================================================================ #

# Chain key for the source chain on Creditcoin (NOT the EVM chainId).
# Verified on CC3 Testnet: 1 = Ethereum Sepolia, 3 = Ethereum Mainnet.
SOURCE_CHAIN_KEY=1

# Proof Builder service. Verified live: 308 redirect -> /api, health OK.
PROOF_BUILDER_URL=https://prover.cc3-testnet.creditcoin.network

# Source chain (Sepolia). Requires an RPC URL.
SOURCE_CHAIN_ID=11155111
SOURCE_CHAIN_RPC_URL=

# Optional: dedicated RPC for the worker's eth_getLogs polling. Some free RPCs
# (e.g. 1rpc.io) throttle getLogs while working fine for regular calls; a
# separate, more reliable poll endpoint keeps the worker stable.
SOURCE_CHAIN_POLL_RPC_URL=

# Optional: frontend audit attach URL. The worker POSTs { txId, attestationStatus,
# attestationTx, sourceTx } here after a proof is submitted, so the console's
# audit panel flips proving -> verified live.
WORKER_AUDIT_ATTACH_URL=http://127.0.0.1:3000/api/veil/audit/attach

# Creditcoin CC3 Testnet (chainId 102031).
CREDITCOIN_RPC_URL=https://rpc.cc3-testnet.creditcoin.network

# Address of the VEIL source contract on Sepolia (deployed by script/deploy.ts).
SOURCE_CHAIN_CONTRACT_ADDRESS=

# Address of the VEIL AttestationReceiver ASC on Creditcoin.
USC_ATTESTATION_RECEIVER_ADDRESS=

# Address of the VEIL SettlementEngine on Creditcoin.
SETTLEMENT_ENGINE_ADDRESS=

# On-chain settlement stack (all on Creditcoin CC3, same chain as the ASC).
# Deployed by script/deploy-settlement.ts. When set, the worker settles orders
# on-chain after BOTH ASC facts are verified: createMandate -> createEscrow
# (signed by the AGENT wallet, needs a small CC3 CTC balance) -> settle().
MANDATE_MANAGER_ADDRESS=
ESCROW_MANAGER_ADDRESS=
REPUTATION_ENGINE_ADDRESS=

# Optional: deploy-settlement.ts will send this many wei of CC3 CTC to the agent
# wallet (SOURCE_CHAIN_WALLET_PRIVATE_KEY) so it can lock escrows.
# Example: 1000000000000000000 = 1 CTC.
FUND_AGENT_CTC=

# Private key of the wallet used to submit proofs to the ASC (funded with CTC via Discord faucet).
CREDITCOIN_WALLET_PRIVATE_KEY=

# Private key of the DEDICATED agent wallet used to sign Sepolia AgentPayment
# records from the frontend rail. Keep this separate from the deployer/operator
# key (address hygiene): the recurring on-chain identity is the agent wallet,
# not the deploy wallet. Fund it with a small Sepolia ETH balance.
SOURCE_CHAIN_WALLET_PRIVATE_KEY=

# Private key of the DEDICATED provider wallet that signs the Sepolia
# FulfillmentReceipt (VeilSource.recordFulfillment is onlyProvider-guarded).
# VEIL_PROVIDER_ADDRESS below must be this wallet's address. Fund it with a
# small Sepolia ETH balance. Demo/mirror mode leaves this empty.
SOURCE_CHAIN_PROVIDER_PRIVATE_KEY=

# Optional: VEIL run mode — `demo` or `production`.
#   demo:       zero-setup. Agent wallets are generated at startup; on-chain
#               recording is disabled, so the vault labels attestation `mirror`.
#   production: agent identity = SOURCE_CHAIN_WALLET_PRIVATE_KEY; every purchase
#               records a live Sepolia event the Attestcoin worker proves.
# If omitted, auto-detect: production when a source-chain key + contract address
# are both set, otherwise demo.
VEIL_MODE=

# Optional: explicitly set the EvmV1Decoder library address deployed on Creditcoin.
# If omitted, deploy.ts will deploy it fresh and reprint the address.
USC_DECODER_LIBRARY_ADDRESS=

# ============================================================================ #
#  Phase 3/4 — Demo provider (services/provider/server.ts)
#  The provider serves a real HTTP endpoint, GET /api/market-data, that:
#    - returns 402 + PAYMENT-REQUIRED when unpaid (real x402 handshake)
#    - serves market data + PAYMENT-RESPONSE when paid via the VEIL rail
#  `veil-exact` is the VEIL demo-adapter VENDOR scheme (NOT official x402).
#  `exact` is the real x402 EIP-3009 scheme, ECRECOVER-verified (no on-chain
#  settlement in the demo — a live USDC/facilitator node is required for that).
# ============================================================================ #

# Provider's own address (shown as payTo in PaymentRequirements).
# In production this is the SOURCE_CHAIN_PROVIDER_PRIVATE_KEY wallet so the
# provider can sign live on-chain fulfillments.
VEIL_PROVIDER_ADDRESS=0x2222222222222222222222222222222222222222

# Settlement operator address allowed to call /api/settle and /api/refund.
PROVIDER_OPERATOR_ADDRESS=0x1111111111111111111111111111111111111111

# Port the provider listens on. Default 8080.
PROVIDER_PORT=8080

# ============================================================================ #
#  Phase 7 — Privacy & audit (services/audit)
#  The audit vault seals sensitive metadata with AES-256-GCM and discloses it
#  only to authorized, EIP-712-signed auditors. The Vault key is NEVER
#  hardcoded: set one the the two options below (or let the demo use an
#  ephemeral key). Attestcoin verifies facts; VEIL controls disclosure.
# ============================================================================ #

# Master vault key, 64 hex chars (32 bytes). Required in production.
VEIL_VAULT_KEY=

# Alternative: path to a file whose first line is the 64-hex key (keeps the
# secret out of env/git entirely).
VEIL_VAULT_KEY_FILE=

# Address allowed to call the operator-only endpoints (record/authorize/revoke).
AUDIT_OPERATOR_ADDRESS=0x1111111111111111111111111111111111111111