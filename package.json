    "express": "^5.2.1",
    "snarkjs": "^0.7.6"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.10.0",
    "tsx": "^4.22.4",
    "typescript": "^5.9.2"
  }
