    "deploy": "tsx script/deploy.ts",
    "deploy:settlement": "tsx script/deploy-settlement.ts",
    "typecheck": "tsc --noEmit",
    "compile-check": "node script/compile-check.js",
    "demo:provider": "tsx services/provider/server.ts",
    "demo": "tsx services/demo/sim.ts",
    "demo:procurement": "tsx services/procurement/demo.ts",
    "demo:audit": "tsx services/audit/demo.ts",
    "agent-b": "tsx services/agent-b/server.ts",
    "replay:attestations": "tsx services/attestation/replay.ts",
    "test:audit": "tsx --test services/audit/audit.test.ts",
    "test:procurement": "tsx --test services/procurement/procurement.test.ts",
    "test:hardening": "tsx --test services/provider/hardening.test.ts",
    "test": "tsx --test services/config/mode.test.ts services/provider/x402.test.ts services/demo/flow.test.ts services/procurement/procurement.test.ts services/audit/audit.test.ts services/provider/hardening.test.ts services/security/scanner.test.ts services/security/zk-prover.test.ts"
  },
  "dependencies": {
